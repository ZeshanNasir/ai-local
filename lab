#!/bin/sh
# ./lab            test every installed model
# ./lab MODEL ...  test only the named models
cd "$(dirname "$0")" || exit 1
command -v python3 >/dev/null 2>&1 || { echo "python3 not found. Install the Xcode Command Line Tools: xcode-select --install" >&2; exit 1; }
python3 -c 'import sys; sys.exit(sys.version_info < (3, 10))' || { echo "Python 3.10 or newer is required." >&2; exit 1; }
exec python3 -m labbench "$@"
